# Copy to .env and fill in. .env is gitignored — this file is the tracked record
# of what the app reads, so keep the two in step when adding a variable.
#
# Two prefixes, two lifecycles:
#   NEXT_PUBLIC_*  inlined into the bundle at BUILD time. Changing one needs a
#                  rebuild, and the value is visible to anyone loading the site.
#   REACT_APP_*    read from the container's env at RUNTIME (via react-env, which
#                  writes public/__ENV.js and strips the prefix, so Config.ts's
#                  env("API_ADDRESS") resolves REACT_APP_API_ADDRESS). Lets one
#                  prebuilt image serve several deployments.
# Unprefixed names are server-only and never reach the browser — keep secrets there.


# ── Hive APIs ────────────────────────────────────────────────────────────────
# Explorer backend (hafbe/haf-stats/balance-api) and the Hive node for RPC.
REACT_APP_API_ADDRESS=https://api.hive.blog
REACT_APP_HIVE_BLOG_API_ADDRESS=https://api.hive.blog

# Front end that post/comment links point at. Blank => https://hive.blog.
REACT_APP_HIVE_FRONTEND_ADDRESS=

# Account sign-up page linked from the Sign In dialog. Blank => https://signup.hive.io.
REACT_APP_SIGNUP_URL=

# Hive imagehoster for avatars and community covers (/u/<name>/avatar, /cover).
# Blank => https://images.hive.blog.
REACT_APP_IMAGE_HOST_URL=


# ── Features (issue #843) ────────────────────────────────────────────────────
# Blank keeps today's full explorer. Any setting below overrides the preset.

# full | classic. classic = the simple explorer: login, dashboard, sync, home
# tabs, Recent Visits, Tools, account Analytics, communities, proposals, Top
# Holders, exports and languages off, classic footer.
REACT_APP_EXPLORER_MODE=

# true | false. Off hides the login button and turns off the auth routes.
REACT_APP_LOGIN=

# Login methods to remove, comma-separated: keychain, hivesigner.
# With hivesigner removed, the Hivesigner settings below are not needed.
# Removing both turns login off.
REACT_APP_LOGIN_EXCLUDE=

# true | false. Off: signed-in users get the same home page as visitors (see
# DEFAULT_TEMPLATE and HOME_TABS) instead of their own dashboard. Needs login.
REACT_APP_DASHBOARD=

# true | false. Off hides workspace sync and turns off /api/workspace/*. Needs
# login and the dashboard: with either off, sync is off too. WORKSPACE_ENCRYPTION_KEY is still needed while Keychain login is on: it
# also signs the login challenge and the session cookie.
REACT_APP_DASHBOARD_SYNC=

# Two rows of board tabs exist:
#   Visitor tabs   - the home page when signed out, or signed in with the
#                    dashboard off. Set by DEFAULT_TEMPLATE, HOME_TABS and
#                    TEMPLATES_EXCLUDE.
#   Dashboard tabs - My Dashboard plus the templates, for signed-in users with
#                    the dashboard on. Set by TEMPLATES_EXCLUDE only; HOME_TABS
#                    does not touch them.

# overview | essentials | network | market | governance. The board the visitor
# tabs open on. Blank => overview.
REACT_APP_DEFAULT_TEMPLATE=

# true | false. Visitor tabs only. Off shows only the default template, with no
# tab row. To trim the signed-in dashboard tabs, use TEMPLATES_EXCLUDE.
# With tabs off, visitors see only the default template, so set
# REACT_APP_DEFAULT_TEMPLATE when you exclude overview.
REACT_APP_HOME_TABS=

# Templates to remove from both the visitor tabs and the dashboard tabs,
# comma-separated: overview, essentials, network, market, governance (both rows)
# and me, creator, growth (dashboard only).
# With overview removed, a new dashboard and "Restore default" use the default
# template. A removed or blank default template falls back to the first home
# board left (essentials, network, market, governance), logged as a warning.
REACT_APP_TEMPLATES_EXCLUDE=

# true | false. Shows or hides Recent Visits in the navbar and Explore menu.
REACT_APP_RECENT_VISITS=

# true | false. Off hides the Tools section and every way into it (menu links,
# profile Compare button, compare picks on lists). /tools pages answer 404.
REACT_APP_TOOLS=

# true | false. Off hides the Analytics tab on account pages; a link to it opens
# the default tab.
REACT_APP_ACCOUNT_ANALYTICS=

# true | false. Off hides communities everywhere (menu, home and dashboard cards,
# community pages show as plain accounts) and /communities answers 404.
REACT_APP_COMMUNITIES=

# true | false. Off hides proposals everywhere (menu, watched proposals, proposal
# votes on profiles) and /proposals answers 404.
REACT_APP_PROPOSALS=

# true | false. Off hides Top Holders everywhere (menu, footer, cards, profile
# rank badges) and /top-holders answers 404.
REACT_APP_TOP_HOLDERS=

# true | false. Off removes every CSV export button.
REACT_APP_EXPORTS=

# true | false. Off hides the language switcher and the whole site uses the
# default language below.
REACT_APP_LANGUAGES=

# en | ar | de | es | fr | it | ja | pl | pt | ro | zh. The language new
# visitors get; a saved choice wins. Blank => en. An excluded one falls back to
# the first language left. e.g. a German-only site: LANGUAGES=false,
# DEFAULT_LANGUAGE=de.
REACT_APP_DEFAULT_LANGUAGE=

# Languages to remove from the switcher, comma-separated: en, ar, de, es, fr, it,
# ja, pl, pt, ro, zh. Only used when languages are on.
REACT_APP_LANGUAGES_EXCLUDE=

# full | classic. classic keeps only the technical details (last commit, Hafbe
# version, Hive node, explorer backend API) and the copyright line.
REACT_APP_FOOTER=

# system | light | dark. Theme for first-time visitors; a saved choice wins.
REACT_APP_DEFAULT_THEME=


# ── Hivesigner login ─────────────────────────────────────────────────────────
# The app name is public; the secret is server-only and must never be prefixed.
# All four are needed: if any one is blank, the Hivesigner login does not
# appear (Keychain stays) and the server logs which ones are missing.
NEXT_PUBLIC_HIVESIGNER_APP=
NEXT_PUBLIC_HIVESIGNER_CALLBACK=http://localhost:3000/
HIVESIGNER_APP=
HIVESIGNER_SECRET=


# ── Workspace sync ───────────────────────────────────────────────────────────
# AES-256-GCM key for the workspace bundle: 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server-only. Rotating it invalidates every stored bundle.
WORKSPACE_ENCRYPTION_KEY=


# ── SEO (issue #726) ─────────────────────────────────────────────────────────
# Every value here has a fallback, so blank is a valid configuration — the
# comments say what happens when it is.

# The canonical public origin, no trailing slash. REQUIRED in production:
# without it, canonical/OG/sitemap URLs are derived from the request Host
# header, which means the SSR pages fall back to `private, no-store` (no shared
# caching at all) and a spoofed Host is reflected back to the requester.
# Set the REACT_APP_ form on real deployments so one image can serve any domain.
NEXT_PUBLIC_SITE_URL=
REACT_APP_SITE_URL=

# Branding in <title> and og:site_name. Blank => "Hive Block Explorer" /
# "Hive Explorer". The default share image (public/og-cover.png) has the default
# name baked in, so a rebranded site should also set DEFAULT_OG_IMAGE below.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_SHORT_NAME=

# Home-page meta description. Blank => the seo.home.description i18n key.
NEXT_PUBLIC_SITE_DESCRIPTION=

# X/Twitter handle for twitter:site, with or without the leading @. Also folded
# into the Organization JSON-LD sameAs. Blank => the tag is omitted.
NEXT_PUBLIC_SITE_TWITTER=

# Comma-separated brand profile URLs for the Organization JSON-LD sameAs.
# Non-http(s) entries are dropped. e.g. https://x.com/acme,https://github.com/acme
NEXT_PUBLIC_SITE_SOCIAL_PROFILES=
REACT_APP_SITE_SOCIAL_PROFILES=

# Default share image: absolute URL, or a site-relative path resolved against
# the origin above. Blank => the static /og-cover.png.
NEXT_PUBLIC_DEFAULT_OG_IMAGE=
REACT_APP_DEFAULT_OG_IMAGE=

# Search-console ownership tokens, emitted as meta tags in _document.
# Blank => the tag is omitted, which is what you want before verifying.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
REACT_APP_GOOGLE_SITE_VERIFICATION=
REACT_APP_BING_SITE_VERIFICATION=


# ── Build / deployment ───────────────────────────────────────────────────────
# Subdirectory deployments (e.g. /explorer). Blank for a root deployment.
# Build-time only: it is compiled into the asset paths, so there is no runtime
# alias — a subdirectory deployment needs its own image.
NEXT_PUBLIC_BASE_PATH=

# "true" selects Next's standalone output, used by the Docker image.
BUILD_STANDALONE=

# Dev only: signs you in as this account without Keychain/Hivesigner. Ignored
# unless NODE_ENV=development.
NEXT_PUBLIC_MOCK_USER=

# Written automatically by helpers/versions.js on each build (git short SHA) and
# shown in the footer. No need to set it by hand.
# NEXT_PUBLIC_COMMIT_HASH=
# Copy to .env and fill in. .env is gitignored — this file is the tracked record
# of what the app reads, so keep the two in step when adding a variable.
#
# Two prefixes, two lifecycles:
#   NEXT_PUBLIC_*  inlined into the bundle at BUILD time. Changing one needs a
#                  rebuild, and the value is visible to anyone loading the site.
#   REACT_APP_*    read from the container's env at RUNTIME (via react-env, which
#                  writes public/__ENV.js and strips the prefix, so Config.ts's
#                  env("API_ADDRESS") resolves REACT_APP_API_ADDRESS). Lets one
#                  prebuilt image serve several deployments.
# Unprefixed names are server-only and never reach the browser — keep secrets there.


# ── Hive APIs ────────────────────────────────────────────────────────────────
# Explorer backend (hafbe/haf-stats/balance-api) and the Hive node for RPC.
REACT_APP_API_ADDRESS=https://api.hive.blog
REACT_APP_HIVE_BLOG_API_ADDRESS=https://api.hive.blog

# Front end that post/comment links point at. Blank => https://hive.blog.
REACT_APP_HIVE_FRONTEND_ADDRESS=


# ── Hivesigner login ─────────────────────────────────────────────────────────
# The app name is public; the secret is server-only and must never be prefixed.
NEXT_PUBLIC_HIVESIGNER_APP=
NEXT_PUBLIC_HIVESIGNER_CALLBACK=http://localhost:3000/
HIVESIGNER_APP=
HIVESIGNER_SECRET=


# ── Workspace sync ───────────────────────────────────────────────────────────
# AES-256-GCM key for the workspace bundle: 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server-only. Rotating it invalidates every stored bundle.
WORKSPACE_ENCRYPTION_KEY=


# ── SEO (issue #726) ─────────────────────────────────────────────────────────
# Every value here has a fallback, so blank is a valid configuration — the
# comments say what happens when it is.

# The canonical public origin, no trailing slash. REQUIRED in production:
# without it, canonical/OG/sitemap URLs are derived from the request Host
# header, which means the SSR pages fall back to `private, no-store` (no shared
# caching at all) and a spoofed Host is reflected back to the requester.
# Set the REACT_APP_ form on real deployments so one image can serve any domain.
NEXT_PUBLIC_SITE_URL=
REACT_APP_SITE_URL=

# Branding in <title>, og:site_name and the generated share images.
# Blank => "Hive Block Explorer" / "Hive Explorer".
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_SHORT_NAME=

# Home-page meta description. Blank => the seo.home.description i18n key.
NEXT_PUBLIC_SITE_DESCRIPTION=

# X/Twitter handle for twitter:site, with or without the leading @. Also folded
# into the Organization JSON-LD sameAs. Blank => the tag is omitted.
NEXT_PUBLIC_SITE_TWITTER=

# Comma-separated brand profile URLs for the Organization JSON-LD sameAs.
# Non-http(s) entries are dropped. e.g. https://x.com/acme,https://github.com/acme
NEXT_PUBLIC_SITE_SOCIAL_PROFILES=
REACT_APP_SITE_SOCIAL_PROFILES=

# Default share image: absolute URL, or a site-relative path resolved against
# the origin above. Blank => the generated cover at /api/og/cover.
NEXT_PUBLIC_DEFAULT_OG_IMAGE=
REACT_APP_DEFAULT_OG_IMAGE=

# Search-console ownership tokens, emitted as meta tags in _document.
# Blank => the tag is omitted, which is what you want before verifying.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
REACT_APP_GOOGLE_SITE_VERIFICATION=
REACT_APP_BING_SITE_VERIFICATION=


# ── Build / deployment ───────────────────────────────────────────────────────
# Subdirectory deployments (e.g. /explorer). Blank for a root deployment.
# Build-time only: it is compiled into the asset paths, so there is no runtime
# alias — a subdirectory deployment needs its own image.
NEXT_PUBLIC_BASE_PATH=

# "true" selects Next's standalone output, used by the Docker image.
BUILD_STANDALONE=

# Dev only: signs you in as this account without Keychain/Hivesigner. Ignored
# unless NODE_ENV=development.
NEXT_PUBLIC_MOCK_USER=

# Written automatically by helpers/versions.js on each build (git short SHA) and
# shown in the footer. No need to set it by hand.
# NEXT_PUBLIC_COMMIT_HASH=